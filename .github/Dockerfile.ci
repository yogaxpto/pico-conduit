# CI Docker image for pico-socketeer
#
# Multi-stage build — Docker BuildKit runs independent stages in PARALLEL.
#
# Stage graph:
#
#   base (tools + toolchain)
#    └─ deps-stub (shared dummy-source setup)
#        ├─ deps-thumbv8m ──────────────────── source-thumbv8m ─┐
#        ├─ deps-thumbv6m ──────────────────── source-thumbv6m ─┤─ final
#        └─ deps-host     ──────────────────── source-host ─────┘
#
# deps-stub holds the COPY + stub-source RUN that is identical across all three
# deps-* stages. BuildKit caches it once; all three deps-* stages branch from it
# and still build in parallel.
#
# Layer caching strategy:
#   - deps-stub is cached when Cargo.lock (and Cargo.toml, build.rs) are unchanged
#   - deps-* stages add only their cargo build/test --no-run invocations on top
#   - Source layers rebuild every push, but reuse cached dep artifacts via sccache
#   - sccache provides per-crate caching across Docker layer invalidations

# ─────────────────────────────────────────────────────────────────────────────
# base: toolchain + tools, shared by all subsequent stages
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:1-alpine AS base

# System deps:
#   git       — required by cargo for git dependencies
#   binutils  — provides `size` (used in flash budget check)
#   curl      — needed for cargo-binstall download
RUN apk add --no-cache git binutils curl

# Rust targets and components (driven by rust-toolchain.toml)
COPY rust-toolchain.toml /tmp/
RUN cd /tmp && rustup show && rm /tmp/rust-toolchain.toml

# cargo-binstall: pre-built binary (~2 seconds vs ~3-5 min compiling)
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  TRIPLE="x86_64-unknown-linux-musl" ;; \
      aarch64) TRIPLE="aarch64-unknown-linux-musl" ;; \
      *) echo "Unsupported: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-${TRIPLE}.tgz" \
      | tar xz -C /usr/local/cargo/bin

# Tools + sccache (shared compilation cache, uses GHA cache backend)
# elf2uf2-rs is included so the release job can convert ELFs without
# installing anything at release time.
RUN cargo binstall flip-link sccache elf2uf2-rs --no-confirm --force

# Enable sccache for all cargo invocations.
# ACTIONS_CACHE_URL and ACTIONS_RUNTIME_TOKEN are injected at build time
# via Docker --mount=type=secret so sccache can read/write the GHA cache.
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_GHA_ENABLED=true

# Compute host triple once; downstream stages source this file.
RUN echo "export HOST_TRIPLE=$(rustc -vV | sed -n 's/host: //p')" > /etc/cargo-env

# ─────────────────────────────────────────────────────────────────────────────
# deps-stub: dummy-source setup shared by all three deps-* stages
#
# Copies only manifest files (Cargo.toml, Cargo.lock, build.rs) and replaces
# source files with minimal stubs so that `cargo build/test --no-run` can
# download and compile all dependencies without touching project source.
# This layer is cached whenever Cargo.lock is unchanged, giving fast deps
# rebuilds on source-only pushes.
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS deps-stub

WORKDIR /tmp/deps

COPY Cargo.toml Cargo.lock rust-toolchain.toml build.rs ./
COPY .cargo .cargo/
COPY memory-pico2w.x memory-pico1w.x ./
COPY client/Cargo.toml client/Cargo.toml
COPY macros/Cargo.toml macros/Cargo.toml

RUN mkdir -p src \
    && echo '#![no_std]' > src/lib.rs \
    && mkdir -p client/src \
    && echo '' > client/src/lib.rs \
    && mkdir -p macros/src \
    && printf 'use proc_macro::TokenStream;\n#[proc_macro_attribute]\npub fn require_env(_: TokenStream, item: TokenStream) -> TokenStream { item }\n' > macros/src/lib.rs \
    && mkdir -p tests/host tests/integration \
    && echo 'fn main(){}' > tests/host/main.rs \
    && echo 'fn main(){}' > tests/integration/main.rs

# ─────────────────────────────────────────────────────────────────────────────
# deps-thumbv8m: pre-compile dependencies for all pico2w feature combos
# ─────────────────────────────────────────────────────────────────────────────
FROM deps-stub AS deps-thumbv8m

RUN --mount=type=secret,id=actions_cache_url,env=ACTIONS_CACHE_URL \
    --mount=type=secret,id=actions_runtime_token,env=ACTIONS_RUNTIME_TOKEN \
    cargo build --release --target thumbv8m.main-none-eabihf --lib \
      --target-dir /cache/target 2>&1 || true \
 && cargo build --release --target thumbv8m.main-none-eabihf \
      --no-default-features --features embedded,pico2w,transport-websocket --lib \
      --target-dir /cache/target 2>&1 || true \
 && cargo build --release --target thumbv8m.main-none-eabihf \
      --no-default-features --features embedded,pico2w,transport-mqtt --lib \
      --target-dir /cache/target 2>&1 || true \
 && cargo build --release --target thumbv8m.main-none-eabihf \
      --no-default-features --features embedded,pico2w,transport-tcp,codec-postcard --lib \
      --target-dir /cache/target 2>&1 || true \
 && sccache --show-stats

# ─────────────────────────────────────────────────────────────────────────────
# deps-thumbv6m: pre-compile dependencies for all pico1w feature combos
# ─────────────────────────────────────────────────────────────────────────────
FROM deps-stub AS deps-thumbv6m

RUN --mount=type=secret,id=actions_cache_url,env=ACTIONS_CACHE_URL \
    --mount=type=secret,id=actions_runtime_token,env=ACTIONS_RUNTIME_TOKEN \
    cargo build --release --target thumbv6m-none-eabi \
      --no-default-features --features embedded,pico1w,transport-tcp --lib \
      --target-dir /cache/target 2>&1 || true \
 && cargo build --release --target thumbv6m-none-eabi \
      --no-default-features --features embedded,pico1w,transport-websocket --lib \
      --target-dir /cache/target 2>&1 || true \
 && cargo build --release --target thumbv6m-none-eabi \
      --no-default-features --features embedded,pico1w,transport-mqtt --lib \
      --target-dir /cache/target 2>&1 || true \
 && sccache --show-stats

# ─────────────────────────────────────────────────────────────────────────────
# deps-host: pre-compile dependencies for host tests and client crate
# ─────────────────────────────────────────────────────────────────────────────
FROM deps-stub AS deps-host

RUN --mount=type=secret,id=actions_cache_url,env=ACTIONS_CACHE_URL \
    --mount=type=secret,id=actions_runtime_token,env=ACTIONS_RUNTIME_TOKEN \
    . /etc/cargo-env \
    && cargo test --no-run --test host --no-default-features \
       --target "$HOST_TRIPLE" --target-dir /cache/target 2>&1 || true \
    && cargo test --no-run --test host --no-default-features --features pico2w \
       --target "$HOST_TRIPLE" --target-dir /cache/target 2>&1 || true \
    && cargo test --no-run --test host --no-default-features --features pico1w \
       --target "$HOST_TRIPLE" --target-dir /cache/target 2>&1 || true \
    && cargo test --no-run -p pico-socketeer-client \
       --target "$HOST_TRIPLE" --target-dir /cache/target 2>&1 || true \
    && sccache --show-stats

# ─────────────────────────────────────────────────────────────────────────────
# source-thumbv8m: clippy + build for all pico2w (thumbv8m) variants
# ─────────────────────────────────────────────────────────────────────────────
FROM deps-thumbv8m AS source-thumbv8m

# Disable sccache for source compilation — deps are already cached in
# /cache/target and sccache credentials may not be available here.
ENV RUSTC_WRAPPER=

WORKDIR /src
COPY . .

RUN set -e; \
    for ARGS in \
      "--release --target thumbv8m.main-none-eabihf" \
      "--release --target thumbv8m.main-none-eabihf --no-default-features --features embedded,pico2w,transport-websocket" \
      "--release --target thumbv8m.main-none-eabihf --no-default-features --features embedded,pico2w,transport-mqtt" \
      "--release --target thumbv8m.main-none-eabihf --no-default-features --features embedded,pico2w,transport-tcp,codec-postcard" \
    ; do \
      cargo clippy $ARGS --target-dir /cache/target -- -D warnings; \
      cargo build $ARGS --target-dir /cache/target; \
    done

# ─────────────────────────────────────────────────────────────────────────────
# source-thumbv6m: clippy + build for all pico1w (thumbv6m) variants
# ─────────────────────────────────────────────────────────────────────────────
FROM deps-thumbv6m AS source-thumbv6m

ENV RUSTC_WRAPPER=

WORKDIR /src
COPY . .

RUN set -e; \
    for ARGS in \
      "--release --target thumbv6m-none-eabi --no-default-features --features embedded,pico1w,transport-tcp" \
      "--release --target thumbv6m-none-eabi --no-default-features --features embedded,pico1w,transport-websocket" \
      "--release --target thumbv6m-none-eabi --no-default-features --features embedded,pico1w,transport-mqtt" \
    ; do \
      cargo clippy $ARGS --target-dir /cache/target -- -D warnings; \
      cargo build $ARGS --target-dir /cache/target; \
    done

# ─────────────────────────────────────────────────────────────────────────────
# source-host: host tests + client crate
# ─────────────────────────────────────────────────────────────────────────────
FROM deps-host AS source-host

ENV RUSTC_WRAPPER=

WORKDIR /src
COPY . .

RUN . /etc/cargo-env \
    && cargo test --no-run --test host --no-default-features \
       --target "$HOST_TRIPLE" --target-dir /cache/target \
    && cargo test --no-run --test host --no-default-features --features pico2w \
       --target "$HOST_TRIPLE" --target-dir /cache/target \
    && cargo test --no-run --test host --no-default-features --features pico1w \
       --target "$HOST_TRIPLE" --target-dir /cache/target \
    && cargo test --no-run -p pico-socketeer-client \
       --target "$HOST_TRIPLE" --target-dir /cache/target \
    && cargo clippy -p pico-socketeer-client \
       --target "$HOST_TRIPLE" --target-dir /cache/target -- -D warnings

# ─────────────────────────────────────────────────────────────────────────────
# final: merge all three architecture subtrees into one image
#
# /cache/target layout after merge:
#   thumbv8m.main-none-eabihf/  ← from source-thumbv8m (base of this stage)
#   thumbv6m-none-eabi/         ← COPY --from=source-thumbv6m  (no overlap)
#   {host-triple}/              ← copied via RUN  (no overlap with embedded dirs)
#
# Downstream CI jobs run with WORKDIR=/src and no actions/checkout —
# cargo fingerprints match because the absolute path is /src.
# ─────────────────────────────────────────────────────────────────────────────
FROM source-thumbv8m AS final

# Merge pico1w artifacts — thumbv6m subtree doesn't exist in source-thumbv8m
COPY --from=source-thumbv6m /cache/target/thumbv6m-none-eabi \
                             /cache/target/thumbv6m-none-eabi

# Merge host artifacts — copy everything that isn't an embedded target dir
COPY --from=source-host /cache/target /tmp/cache-host
RUN find /tmp/cache-host -mindepth 1 -maxdepth 1 \
      ! -name 'thumbv8m*' ! -name 'thumbv6m*' \
      -exec cp -r {} /cache/target/ \; \
    && rm -rf /tmp/cache-host

# /etc/cargo-env (host triple) is intentionally kept in the final image.
