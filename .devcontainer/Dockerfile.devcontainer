# syntax=docker/dockerfile:1
FROM rust:1-alpine

RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    apk add \
        bash \
        git \
        curl \
        unzip \
        zsh \
        musl-dev \
        pkgconf \
        eudev-dev \
        libusb-dev \
        openssl-dev \
        build-base \
        openssh-client

# Install oh-my-zsh
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

# Rust toolchain — targets + components driven by rust-toolchain.toml
COPY rust-toolchain.toml /tmp/
RUN cd /tmp && rustup show && rm /tmp/rust-toolchain.toml

# cargo-binstall: pre-built binary (~2 seconds vs ~3-5 min compiling)
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  TRIPLE="x86_64-unknown-linux-musl" ;; \
      aarch64) TRIPLE="aarch64-unknown-linux-musl" ;; \
      *) echo "Unsupported: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-${TRIPLE}.tgz" \
      | tar xz -C /usr/local/cargo/bin

# Embedded tools — ordered cheapest → most expensive for layer cache efficiency.
# If only flip-link updates, probe-rs and elf2uf2-rs layers stay cached.

# flip-link: pre-built binary via binstall (~5 seconds)
RUN cargo binstall flip-link --no-confirm --force

# Quality tools used by `make ci` (audit + machete): pre-built binaries (~5 seconds)
RUN cargo binstall cargo-audit cargo-machete --no-confirm --force

# elf2uf2-rs: no pre-built musl binaries, compile from source (~2-3 min)
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo install elf2uf2-rs --locked

# probe-rs-tools: no musl binaries, compile from source (~10-15 min)
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo install probe-rs-tools --locked

# Pre-download rust-analyzer VS Code extension VSIX.
# The alpine-arm64 marketplace variant does not exist; VS Code Server's built-in downloader
# also fails to decompress the HTTP gzip encoding. --compressed decodes it into a valid ZIP.
# Installed via postCreateCommand rather than the extensions list to bypass the 404.
RUN curl -fsSL --compressed \
    "https://marketplace.visualstudio.com/_apis/public/gallery/publishers/rust-lang/vsextensions/rust-analyzer/latest/vspackage" \
    -o /usr/local/share/rust-analyzer.vsix

# Ensure rust-analyzer component is installed (rustup show may skip it if the
# toolchain was already present) and symlink to /usr/local/bin for VS Code.
RUN rustup component add rust-analyzer \
    && ln -sf "$(rustup which rust-analyzer)" /usr/local/bin/rust-analyzer

# Helper script: extracts the VSIX directly into ~/.vscode-server/extensions so VS Code
# Server picks it up on first start without needing the `code` CLI or an IPC socket.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'EXT_DIR="${HOME}/.vscode-server/extensions"' \
    'VSIX="/usr/local/share/rust-analyzer.vsix"' \
    'mkdir -p "${EXT_DIR}"' \
    'T=$(mktemp -d)' \
    'unzip -q "${VSIX}" -d "${T}"' \
    'V=$(awk -F"\"" "/  \"version\":/{print \$4; exit}" "${T}/extension/package.json")' \
    'DEST="${EXT_DIR}/rust-lang.rust-analyzer-${V}"' \
    '[ -d "${DEST}" ] || mv "${T}/extension" "${DEST}"' \
    'rm -rf "${T}"' \
    > /usr/local/bin/install-ra-vsix \
    && chmod +x /usr/local/bin/install-ra-vsix

# Allow postCreateCommand to update or modify the toolchain as any container user.
RUN chmod -R a+w /usr/local/rustup /usr/local/cargo
